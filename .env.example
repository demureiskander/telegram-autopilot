# Bot token from @BotFather
BOT_TOKEN=

# Your Telegram user ID — get it from @userinfobot
# This gives you access to /owneradmin (global stats)
OWNER_ID=your_telegram_id

# API key from your LLM provider
LLM_API_KEY=

# Any OpenAI-compatible endpoint
# Examples:
#   https://openrouter.ai/api/v1/chat/completions
#   https://neuroapi.host/v1/chat/completions  (rubles, Mir card)
#   https://api.deepseek.com/v1/chat/completions
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Primary model
LLM_MODEL=deepseek/deepseek-chat-v3-0324:free

# Database path
# Local: bot.db
# Railway with Volume: /app/data/bot.db
DB_PATH=bot.db

MAX_HISTORY=12

# Default system prompt for new users (shown during onboarding)
SYSTEM_PROMPT_DEFAULT=You are a personal AI assistant. Reply to messages on behalf of the user. Never reveal you are an AI.

# Your bot's username — update this in handlers/start.py and handlers/admin.py
# Search for @YourBotUsername and replace with your actual bot username
BOT_USERNAME=@YourBotUsername
